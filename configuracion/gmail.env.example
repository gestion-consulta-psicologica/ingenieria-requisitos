# Plantilla de correo con Gmail para la consulta psicológica.
#
# NO pongas tu clave en este archivo. Cópialo FUERA del repositorio y complétalo:
#
#   mkdir -p ~/.config/consulta
#   cp configuracion/gmail.env.example ~/.config/consulta/correo.env
#   chmod 600 ~/.config/consulta/correo.env
#   nano ~/.config/consulta/correo.env        # reemplaza los valores <...>
#
# Cárgalo en la terminal antes de arrancar la aplicación o el comando de prueba:
#
#   set -a; source ~/.config/consulta/correo.env; set +a
#   python -m app.probar_correo <tu-correo>
#
# SMTP_CLAVE es una *contraseña de aplicación* de Google (16 caracteres), no tu
# contraseña normal. Se crea en https://myaccount.google.com/apppasswords y
# requiere tener activa la verificación en 2 pasos.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=<tu-cuenta>@gmail.com
SMTP_CLAVE=<contraseña-de-aplicacion-de-16-caracteres>
# Debe ser la misma cuenta de SMTP_USUARIO (o un alias verificado de ella).
SMTP_REMITENTE=<tu-cuenta>@gmail.com

# URL que verá el paciente en los enlaces de confirmación. En local basta con
# http://127.0.0.1:8000; en el modo con cuentas debe ser la URL HTTPS pública.
CORREO_URL_PUBLICA=http://127.0.0.1:8000
