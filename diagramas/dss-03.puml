@startuml dss-03
' DSS-03 — Reservar hora (CU-02 / HU-02, incluye CU-01 / HU-01)
skinparam shadowing false
skinparam sequenceMessageAlign center
hide footbox

title DSS-03 — Reservar hora

actor "Paciente" as PAC
participant ":Sistema de gestión\nde consulta" as SIS
participant ":Cola de correos" as COLA
participant ":Servicio SMTP\n<<sistema externo>>" as SMTP

PAC -> SIS : consultar disponibilidad de la semana

alt existen bloques horarios disponibles
  SIS --> PAC : mostrar bloques horarios disponibles

  PAC -> SIS : seleccionar y reservar bloque horario

  alt el bloque sigue disponible y el paciente tiene sus datos de identificación
    SIS -> SIS : registrar reserva en estado\n"Pendiente de confirmación"
    SIS -> SIS : ocupar bloque horario
    SIS -> SIS : programar ciclo de confirmación\nsegún los plazos establecidos

    SIS --> PAC : confirmar reserva registrada

    SIS -> COLA : encolar aviso de reserva registrada
    COLA -> SMTP : enviar aviso de reserva\nal correo del paciente

    alt el servidor SMTP acepta el mensaje
      SMTP --> COLA : mensaje aceptado y Message-ID
      COLA -> COLA : registrar envío aceptado
    else el servidor SMTP no acepta el mensaje
      SMTP --> COLA : informar error de envío
      COLA -> COLA : programar reintento
    end

  else el bloque fue reservado por otro paciente
    SIS --> PAC : informar que el bloque no está disponible\ny mostrar alternativas cercanas

  else faltan datos de identificación del paciente
    SIS --> PAC : solicitar completar datos de identificación
  end

else no existen bloques horarios disponibles
  SIS --> PAC : informar que no hay horas disponibles\ny mostrar fecha del próximo bloque disponible
end

@enduml
